set shell := ["bash", "-euo", "pipefail", "-c"]

test:
    go test -race -count=1 ./...

build:
    CGO_ENABLED=0 GOOS=linux go build -trimpath -o verification-agent ./cmd

format:
    golangci-lint fmt ./cmd/... ./internal/... ./e2e/...

lint:
    golangci-lint fmt --diff ./cmd/... ./internal/... ./e2e/...
    golangci-lint run ./cmd/... ./internal/...
